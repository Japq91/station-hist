# Credenciales del portal SENAMHI (site/descarga-datos) usadas en el paso de "Ingreso"
SENAMHI_EMAIL=
SENAMHI_PASSWORD=

# Ruta opcional al ejecutable del navegador (Chrome/Brave/Edge).
# Si se deja vacio, se autodetecta igual que en Garua (check_browser()).
GARUA_BROWSER_PATH=

# Carpeta donde tu navegador guarda las descargas por defecto (tu carpeta
# real de Descargas del sistema operativo). Por defecto: ~/Downloads
BROWSER_DOWNLOADS_DIR=
